DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one development server.
DISCORD_GUILD_ID=

BOT_PRODUCT_NAME=Prism
BOT_ADMIN_COMMAND_NAME=prism
BOT_ACCENT_COLOR="#22D3EE"

WIKI_REMOTE_URL=https://github.com/Boof2015/prism.wiki.git
WIKI_BASE_URL=https://github.com/Boof2015/prism/wiki
WIKI_DIRECTORY=./data/wiki
WIKI_SYNC_ENABLED=true
WIKI_POLL_MINUTES=5

SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_MODEL=google/embeddinggemma-300m
MODEL_CACHE_DIRECTORY=./data/model-cache
EMBEDDING_CACHE_FILE=./data/embeddings.json
BOT_STATE_FILE=./data/bot-state.json
ALIASES_FILE=./config/prism-aliases.yml

STATUS_MESSAGES_FILE=./config/statuses.yml
# Compose overrides this with the volume shared by both bots.
STATUS_SHARED_DIRECTORY=./data/status-presence
